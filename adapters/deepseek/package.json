{
  "name": "dsh-experience-strategy-harness",
  "version": "0.3.0-alpha.1",
  "description": "Persistent experience checkpoints on the native DeepSeek Harness lifecycle",
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "scripts/*.py",
    "SKILL.md",
    "EXPERIENCE-HARNESS.md",
    "references/*.md",
    "templates/*.md",
    "README.md",
    "UPSTREAM.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "yaml": "2.8.1"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
